local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local LocalPlayer = Players.LocalPlayer
local placeId = game.PlaceId

local success, gameInfo = pcall(function()
    return MarketplaceService:GetProductInfo(placeId)
end)

local gameName = success and gameInfo.Name or "Nome Desconhecido"

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GameNameGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = (syn and game.CoreGui) or (gethui and gethui()) or Players.LocalPlayer:WaitForChild("PlayerGui")

-- Botão para abrir o menu
local openButton = Instance.new("TextButton")
openButton.Size = UDim2.new(0, 120, 0, 40)
openButton.Position = UDim2.new(0, 10, 0.5, -20)
openButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
openButton.Text = "ABRIR MENU"
openButton.Font = Enum.Font.GothamBold
openButton.TextSize = 16
openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
openButton.Parent = screenGui
openButton.Active = true
openButton.Draggable = true

-- Frame principal do menu
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 140)
frame.Position = UDim2.new(0.5, -150, 0.5, -70)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.Parent = screenGui
frame.Visible = false
frame.Active = true
frame.Draggable = true

-- Título do menu
local header = Instance.new("TextLabel")
header.Size = UDim2.new(1, 0, 0, 30)
header.Position = UDim2.new(0, 0, 0, 0)
header.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
header.Text = "CRIADO POR @coroadinho_37203"
header.TextColor3 = Color3.fromRGB(255, 255, 255)
header.TextScaled = true
header.Font = Enum.Font.GothamBold
header.Parent = frame

-- Nome do jogo
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 30)
title.Position = UDim2.new(0, 10, 0, 40)
title.BackgroundTransparency = 1
title.Text = gameName
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Font = Enum.Font.Gotham
title.Parent = frame

-- Botão copiar nome
local copyButton = Instance.new("TextButton")
copyButton.Size = UDim2.new(0, 120, 0, 30)
copyButton.Position = UDim2.new(0.5, -60, 0, 75)
copyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
copyButton.Text = "COPIAR NOME"
copyButton.Font = Enum.Font.Gotham
copyButton.TextSize = 16
copyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
copyButton.Parent = frame

-- Notificação de cópia
local notification = Instance.new("TextLabel")
notification.Size = UDim2.new(1, 0, 0, 30)
notification.Position = UDim2.new(0, 0, 1, -30)
notification.BackgroundTransparency = 1
notification.Text = ""
notification.TextColor3 = Color3.fromRGB(0, 255, 0)
notification.TextScaled = true
notification.Font = Enum.Font.Gotham
notification.Parent = frame

-- Botão fechar menu
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 100, 0, 30)
closeButton.Position = UDim2.new(1, -110, 0, 5)
closeButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
closeButton.Text = "FECHAR"
closeButton.Font = Enum.Font.GothamBold
closeButton.TextSize = 14
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.Parent = frame

-- Funções
copyButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(gameName)
    elseif Clipboard and Clipboard.set then
        Clipboard.set(gameName)
    end
    notification.Text = "Nome copiado com sucesso!"
    task.delay(2, function()
        notification.Text = ""
    end)
end)

closeButton.MouseButton1Click:Connect(function()
    frame.Visible = false
    openButton.Visible = true
end)

openButton.MouseButton1Click:Connect(function()
    frame.Visible = true
    openButton.Visible = false
end)
